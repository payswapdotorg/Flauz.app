    "@types/node": "^24.13.6",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.0",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  }
